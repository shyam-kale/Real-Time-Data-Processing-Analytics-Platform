# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=DataFlow
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database (MySQL) ────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dataflow
MYSQL_PASSWORD=dataflow_password
MYSQL_DATABASE=dataflow_db
DATABASE_URL=mysql+aiomysql://dataflow:dataflow_password@localhost:3306/dataflow_db
DATABASE_URL_SYNC=mysql+pymysql://dataflow:dataflow_password@localhost:3306/dataflow_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500

# ─── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# ─── Railway (production overrides) ────────────────────────────────────────────
# VITE_API_BASE_URL=https://dataflow-api.up.railway.app
# VITE_WS_BASE_URL=wss://dataflow-api.up.railway.app
